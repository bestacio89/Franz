{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Database": {
    "Provider": "Postgres",
    "ServerName": "127.0.0.1",
    "DatabaseName": "franz_dev",
    "UserName": "postgres",
    "Password": "",
    "Port": 5432,
    "Ssl": "Disable"
  },
  "Messaging": {
    "Provider": "kafka",
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "franz-consumer-group",
      "ClientId": "franz-consumer",
      "TopicName": "franz",
      "Consumer": {
        "AutoOffsetReset": "Earliest",
        "EnableAutoCommit": false,
        "EnableAutoOffsetStore": false,
        "ConcurrencyLevel": 1
      },
      "Producer": {
        "Acks": "All",
        "EnableIdempotence": true,
        "CompressionType": "Snappy"
      },
      "Failure": {
        "EnableDeadLetter": true,
        "MaxRetryAttempts": 3,
        "RetryBackoffMs": 500,
        "UseOriginalMessageKey": true
      },
      "Observability": {
        "EnableMetrics": true,
        "EnableTracing": true,
        "EnableLogging": true,
        "LogMessagePayloads": false
      }
    },
    "Outbox": {
      "Enabled": true,
      "FlushIntervalSeconds": 10,
      "MaxBatchSize": 100
    },
    "Context": {
      "IncludeTenant": true,
      "IncludeCorrelationId": true,
      "IncludeUserIdentity": true
    }
  },
  "Resilience": {
    "RetryPolicy": {
      "Enabled": true,
      "RetryCount": 3,
      "RetryIntervalMilliseconds": 500
    },
    "CircuitBreaker": {
      "Enabled": true,
      "FailureThreshold": 0.5,
      "MinimumThroughput": 10,
      "DurationOfBreakSeconds": 30
    },
    "TimeoutPolicy": {
      "Enabled": true,
      "TimeoutSeconds": 5
    },
    "BulkheadPolicy": {
      "Enabled": true,
      "MaxParallelization": 10,
      "MaxQueueSize": 20
    }
  },
  "Tracing": {
    "OpenTelemetry": {
      "Enabled": true,
      "SourceName": "Franz.Messaging",
      "Exporter": "otlp",
      "Endpoint": "http://localhost:4317"
    }
  },
  "TIdType": "Guid",
  "TenantStrategy": "Header"
}
